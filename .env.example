# HireMeBot frontend — public, non-secret configuration only.
# Copy this file to `.env.local` and fill in the values for your environment.
# Never commit real secrets, Cognito client secrets, or AWS credentials.

# --- Student API data source ----------------------------------------------
# "mock" (default) uses the in-process MockStudentService so the UI runs
# with no backend. "live" calls the real StudentLambda via VITE_API_BASE_URL
# and VITE_DEV_STUDENT_ID below.
VITE_STUDENT_API_MODE=mock

# Base URL for the HireMeBot backend API (API Gateway stage).
# Only read in live mode.
VITE_API_BASE_URL=http://127.0.0.1:3000

# Development-only Student ID sent as `X-Dev-Student-Id` on every student
# API call. Required in live mode until Cognito/JWT auth replaces it.
VITE_DEV_STUDENT_ID=1000000002

# --- Cognito (not yet wired to runtime) -----------------------------------
# Reserved for the future Cognito integration. See docs/BACKEND.md.
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_DOMAIN=hiremebot.auth.us-east-1.amazoncognito.com
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/login

# Reserved: future auth-provider selector (mock|cognito). Not read at runtime
# today — the frontend uses MockAuthService until Cognito ships.
VITE_AUTH_PROVIDER=mock
