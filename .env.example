# HireMeBot frontend — public, non-secret configuration only.
# Copy this file to `.env.local` and fill in the values for your environment.
# Never commit real secrets, Cognito client secrets, or AWS credentials.

# --- Student API data source ----------------------------------------------
# "mock" (default) uses the in-process MockStudentService so the UI runs
# with no backend. "live" calls the real StudentLambda via VITE_API_BASE_URL.
# The student is the signed-in user: their `studentId` (from GET /auth/me) is
# sent as the dev-only `X-Dev-Student-Id` header until the dashboard API
# accepts the Cognito Bearer token. No student id is configured here.
VITE_STUDENT_API_MODE=mock

# Base URL for the HireMeBot backend API (API Gateway stage). Used by the
# student account API (GET /api/v1/auth/me, POST /api/v1/students/register)
# in every mode, and by the dashboard API in live mode. Leave empty to use
# same-origin /api paths through the Vite dev proxy.
# Local: `sam local start-api --env-vars env.json` on port 3000. The backend
# allows the CORS origin http://localhost:5173 only.
VITE_API_BASE_URL=http://127.0.0.1:3000

# Optional full-URL overrides for the account API (deployed stack outputs
# `AccountLookupUrl` and `StudentRegistrationUrl`). Override both or neither.
# VITE_ACCOUNT_LOOKUP_URL=https://xxxx.execute-api.us-east-2.amazonaws.com/Prod/api/v1/auth/me
# VITE_STUDENT_REGISTRATION_URL=https://xxxx.execute-api.us-east-2.amazonaws.com/Prod/api/v1/students/register

# --- Amazon Cognito (Google sign-in via AWS Amplify v6) ------------------
# Public values only: the app client is a public client with no secret.
# NEVER put the Google OAuth client secret (or any AWS credential) here — it
# is configured inside the Cognito user pool's Google identity provider.
#
# Local development: copy these into .env.local with your real pool values.
# Production (Vercel): set the same variables in Project Settings →
# Environment Variables using your deployed URL, and add that exact callback
# and sign-out URL to the Cognito app client first.
VITE_COGNITO_USER_POOL_ID=us-east-2_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Bare Cognito domain — no https:// prefix, no trailing slash.
VITE_COGNITO_DOMAIN=your-domain.auth.us-east-2.amazoncognito.com
# Must exactly match an "Allowed callback URL" on the Cognito app client and
# share the origin the app is served from. Comma-separate multiple URLs.
VITE_COGNITO_REDIRECT_URL=http://localhost:5173/auth/callback
# Must exactly match an "Allowed sign-out URL" on the Cognito app client.
VITE_COGNITO_SIGNOUT_URL=http://localhost:5173/
